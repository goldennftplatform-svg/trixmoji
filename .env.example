# Copy to .env for local, or set in Netlify -> Site settings -> Environment variables
# Never commit .env. Never put keys in frontend JS.

XAI_API_KEY=
XAI_MODEL=grok-4.5

# Phunks direct mint. Enable only after contract/artwork and purchase verification.
PHUNK_MINT_ENABLED=false
# Public Reown project ID (allowlist doswapz.com in the Reown dashboard).
WALLETCONNECT_PROJECT_ID=
# Optional dedicated Ethereum mainnet RPC, used only on the server.
ETH_RPC_URL=
# Protocol-aware indexer. A successful Ethereum receipt alone does not prove a valid Ethscription.
ETHSCRIPTIONS_INDEXER_URL=https://api.ethscriptions.com/v2

# Optional tuning
# HARBINGER_MAX_TOKENS=500
# HARBINGER_RATE_PER_MIN=12
# HARBINGER_RATE_PER_DAY=80

# Comma-separated browser origins allowed to call /api/harbinger-chat
# Netlify URL is auto-added from URL / DEPLOY_PRIME_URL when present.
# HARBINGER_ALLOWED_ORIGINS=https://yoursite.netlify.app,https://www.yoursite.com

# --- Pond old-rails (activated rig gate) ---
# POST /api/pond-rigs-sync with Authorization: Bearer $POND_RIGS_SYNC_SECRET
# Cron every 6h when DUNE_API_KEY + DUNE_POND_RIG_QUERY_ID are set.
POND_RIGS_SYNC_SECRET=
POND_COMMUNITY_MODE=rigs_only
# POND_COMMUNITY_BLOCKLIST=
#
# Dune (https://dune.com -> Settings -> API -> create key)
DUNE_API_KEY=
DUNE_POND_RIG_QUERY_ID=
# DUNE_POND_RIG_RESULT_LIMIT=250000
#
# Optional durable store (recommended for large Dune lists):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Pond passport (YOUR login only — no Cary) ---
# From browser Network while logged into pond0x.com:
#   Cookie header value for the POST to https://www.pond0x.com/ that returns user/passport
# NEVER commit real cookies. Set only in Netlify env. Refresh when session dies (~hours).
POND_SESSION_COOKIE=
# Optional override if Pond changes server action id
# POND_NEXT_ACTION=00eb55675a475f8eb5dc95c8fafc8ba5755a2dae94
# Optional short-lived fallback: passport-cache JWT only
# POND_PASSPORT_CACHE=

# --- Sign in with X (identity only — never scrape timelines) ---
# OAuth 2.0 Web App. Callback must match exactly:
#   http://127.0.0.1:8890/api/auth/x
#   https://doswapz.com/api/auth/x
# Scopes used: users.read tweet.read (X requires tweet.read for /2/users/me;
# we never call tweet endpoints; token is discarded after identity).
X_CLIENT_ID=
X_CLIENT_SECRET=
X_SESSION_SECRET=
# X_REDIRECT_URI=http://127.0.0.1:8890/api/auth/x
# Production:
# X_REDIRECT_URI=https://doswapz.com/api/auth/x

# --- The Attic drop tracker (LAUNCH PREP - leave LIVE off) ---
# Public board API works without these (reads bundled JSON / watchlist).
# ATTIC_DROPS_LIVE=1   # ONLY at launch - arms /api/attic-drops-check
# ATTIC_DROPS_ADMIN_SECRET=   # long random string; required for admin POST + check
# ATTIC_DROPS_WEBHOOK_URL=    # optional Discord/Slack webhook on status change
# KV_REST_API_URL=            # already used for attic posts; also drops board
# KV_REST_API_TOKEN=
